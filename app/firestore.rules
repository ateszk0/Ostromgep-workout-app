rules_version = '2';

// Paste into Firebase console -> Firestore -> Rules, then Publish.
//
// - users/{uid}: the full private backup document. Owner-only.
// - publicProfiles/{uid}: the shareable subset for Friends. Readable by any
//   signed-in user, written only by its owner (with size limits).
// - friends/{uid}/list/{friendUid}: each user's own friend list. Only the
//   owner writes; the friend may `get` their own entry to see whether the
//   other side still lists them (mutual unfriend).
// - friends/{uid}/sent/{targetUid}: requests I sent, owner-only bookkeeping.
// - friendRequests/{owner}/incoming/{requester}: a request, created by the
//   requester (unless blocked), approved/declined by the owner.
// - blocks/{uid}/list/{blockedUid}: owner-only block list.
// - nudges/{recipient}/inbox/{id}: nudges sent to me. A friend may create one
//   only outside the 4 h cooldown, in the same batch that stamps
//   nudgeState/{from}_{to} with the same server time.
// - duels/{id}: a weekly 1v1 volume duel between two friends. Each side only
//   writes its own volume field; the opponent answers the invite.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.username.size() <= 40
        && request.resource.data.recentEvents.size() <= 10
        && request.resource.data.seasonHistory.size() <= 24;
    }

    match /friends/{uid}/list/{friendUid} {
      allow get: if signedIn() && (request.auth.uid == uid || request.auth.uid == friendUid);
      allow list, write: if signedIn() && request.auth.uid == uid;
    }

    match /friends/{uid}/sent/{targetUid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /friendRequests/{owner}/incoming/{requester} {
      allow create: if signedIn() && request.auth.uid == requester
        && request.resource.data.status == 'pending'
        && !exists(/databases/$(database)/documents/blocks/$(owner)/list/$(request.auth.uid));
      allow get: if signedIn() && (request.auth.uid == owner || request.auth.uid == requester);
      allow list: if signedIn() && request.auth.uid == owner;
      allow update: if signedIn() && request.auth.uid == owner
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if signedIn() && (request.auth.uid == owner || request.auth.uid == requester);
    }

    match /blocks/{uid}/list/{blockedUid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    function nudgeState(from, to) {
      return /databases/$(database)/documents/nudgeState/$(from + '_' + to);
    }

    match /nudges/{recipient}/inbox/{id} {
      allow read, delete: if signedIn() && request.auth.uid == recipient;
      allow create: if signedIn()
        && request.auth.uid != recipient
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.code in ['NUDGE', 'GG', 'WORKOUT_Q']
        && request.resource.data.fromName.size() <= 40
        && request.resource.data.sentAt == request.time
        && exists(/databases/$(database)/documents/friends/$(recipient)/list/$(request.auth.uid))
        && !exists(/databases/$(database)/documents/blocks/$(recipient)/list/$(request.auth.uid))
        && (!exists(nudgeState(request.auth.uid, recipient))
            || request.time > get(nudgeState(request.auth.uid, recipient)).data.lastSentAt + duration.value(4, 'h'))
        && getAfter(nudgeState(request.auth.uid, recipient)).data.lastSentAt == request.time;
    }

    match /nudgeState/{pair} {
      allow read: if signedIn() && pair.matches(request.auth.uid + '_.*');
      allow create, update: if signedIn() && pair.matches(request.auth.uid + '_.*')
        && request.resource.data.lastSentAt == request.time;
    }

    match /duels/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.challengerUid == request.auth.uid
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.opponentUid in request.resource.data.participants
        && request.resource.data.opponentUid != request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.challengerKg == 0
        && request.resource.data.opponentKg == 0
        && exists(/databases/$(database)/documents/friends/$(request.resource.data.opponentUid)/list/$(request.auth.uid))
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.opponentUid)/list/$(request.auth.uid));
      allow update: if signedIn() && request.auth.uid in resource.data.participants && (
        (request.auth.uid == resource.data.opponentUid
          && resource.data.status == 'PENDING'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['ACTIVE', 'DECLINED'])
        || (request.auth.uid == resource.data.challengerUid
          && resource.data.status == 'ACTIVE'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['challengerKg']))
        || (request.auth.uid == resource.data.opponentUid
          && resource.data.status == 'ACTIVE'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['opponentKg']))
      );
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;
    }
  }
}
